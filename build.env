# Single source of truth for the toolchain and board. Plain KEY=VALUE lines (no
# quotes, no spaces) so the Makefile can `include` it and the workflows can
# append it to $GITHUB_ENV.
ARDUINO_CLI_VERSION=1.5.1
CORE_VERSION=3.3.11
# USBMode=default is USB-OTG (TinyUSB), required for a HID mouse.
# CDCOnBoot=cdc is "Disabled" (the menu labels are swapped in the XIAO
# definition), so the board enumerates as a mouse only, with no serial port.
FQBN=esp32:esp32:XIAO_ESP32S3:USBMode=default,CDCOnBoot=cdc,PartitionScheme=default_8MB,DebugLevel=none
CHIP=esp32s3
SKETCH=usb_mouse_jiggler
